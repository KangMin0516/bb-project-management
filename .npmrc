# pnpm fetch tuning - applies to both local dev and CI builds.
#
# Defaults are tuned for a fast connection. The CI build for #50 timed
# out after 5.5 min because registry.npmjs.org tarballs were trickling
# in at 30-50 KiB/s and pnpm's default fetch-timeout (60s) is too tight
# for big tarballs like @rolldown/binding-linux-x64-musl (~13 MiB).
#
# These values are conservative; they cost nothing on a fast connection
# and survive a slow / flaky registry on a bad day.

fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
network-concurrency=8
