# Database
DATABASE_URL="postgresql://bbpm:bbpm_secret@localhost:5433/bbpm_db"

# JWT (user session)
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRES_IN="1h"

# JWT (public share links) — MUST be a different secret from JWT_SECRET.
# Both strategies cross-reject the other kind, but using a separate secret
# means a leak of either secret only blasts its own surface.
JWT_SHARE_SECRET="change-this-to-a-different-random-secret"
SHARE_JWT_EXPIRES_IN="2h"
SHARE_LINK_PASSCODE_FAIL_THRESHOLD=20
SHARE_LINK_LOCKOUT_MINUTES=60

# Admin seed
ADMIN_EMAIL="admin@burningb.com"
ADMIN_PASSWORD="changeme123"

# App
API_PORT=3000
NODE_ENV=development
