generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User ───────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  avatar       String?
  status       UserStatus @default(PENDING)
  slackUserId  String?    @unique @map("slack_user_id")
  isSuperuser  Boolean    @default(false) @map("is_superuser")
  refreshToken String?    @map("refresh_token")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships               ProjectMember[]
  assignedIssues            Issue[]              @relation("AssignedIssues")
  reviewerIssues            Issue[]              @relation("ReviewerIssues")
  createdIssues             Issue[]              @relation("CreatedIssues")
  activities                Activity[]
  comments                  Comment[]
  attachments               Attachment[]
  apiKeys                   ApiKey[]
  templates                 IssueTemplate[]
  notifications             Notification[]
  createdLinks              IssueLink[]          @relation("CreatedLinks")
  componentLeads            Component[]          @relation("ComponentLead")
  componentDefaultAssignees Component[]          @relation("ComponentDefaultAssignee")
  createdSpecs              Specification[]      @relation("CreatedSpecs")
  specComments              SpecComment[]        @relation("SpecComments")
  credentials               ProjectCredential[]  @relation("UserCredentials")
  slackInstallations        SlackIntegration[]
  githubInstallations       GitHubIntegration[]
  joinRequests              ProjectJoinRequest[] @relation("JoinRequester")
  resolvedJoinRequests      ProjectJoinRequest[] @relation("JoinResolver")
  oauthAuthCodes            OAuthAuthCode[]
  oauthAccessTokens         OAuthAccessToken[]
  oauthRefreshTokens        OAuthRefreshToken[]

  @@map("users")
}

// ─── Project ────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members           ProjectMember[]
  issues            Issue[]
  labels            Label[]
  components        Component[]
  specifications    Specification[]
  credentials       ProjectCredential[]
  reportConfig      DailyReportConfig?
  githubIntegration GitHubIntegration?
  joinRequests      ProjectJoinRequest[]

  @@map("projects")
}

// ─── Project Member ─────────────────────────────────────────

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now()) @map("created_at")

  userId    String  @map("user_id")
  projectId String  @map("project_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_members")
}

enum ProjectRole {
  ADMIN
  PM
  DEVELOPER
}

// ─── Project Join Request ──────────────────────────────────

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectJoinRequest {
  id              String            @id @default(uuid())
  status          JoinRequestStatus @default(PENDING)
  message         String?           @db.VarChar(500)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime          @default(now()) @map("created_at")
  resolvedAt      DateTime?         @map("resolved_at")

  requesterId String @map("requester_id")
  requester   User   @relation("JoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  resolvedById String? @map("resolved_by_id")
  resolvedBy   User?   @relation("JoinResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([requesterId, projectId])
  @@index([projectId, status])
  @@map("project_join_requests")
}

// ─── Issue ──────────────────────────────────────────────────

model Issue {
  id          String        @id @default(uuid())
  number      Int
  title       String        @db.VarChar(500)
  description String?
  status      IssueStatus   @default(BACKLOG)
  priority    IssuePriority @default(MEDIUM)
  type        IssueType     @default(TASK)
  order       Int           @default(0)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  focusDate   DateTime?     @map("focus_date") @db.Date
  isRecheck   Boolean       @default(false) @map("is_recheck")
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // How this issue was created. Set at insert from the request's
  // detected client (WEB / MCP / SLACK / WEBHOOK / API / SYSTEM).
  // Stored as VARCHAR rather than a Prisma enum so new clients can be
  // added without a migration.
  source String @default("WEB") @db.VarChar(20)

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  reviewerAssigneeId String? @map("reviewer_assignee_id")
  reviewerAssignee   User?   @relation("ReviewerIssues", fields: [reviewerAssigneeId], references: [id], onDelete: SetNull)

  creatorId String? @map("creator_id")
  creator   User?   @relation("CreatedIssues", fields: [creatorId], references: [id], onDelete: SetNull)

  parentId String? @map("parent_id")
  parent   Issue?  @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("SubIssues")

  labels        IssueLabel[]
  components    IssueComponent[]
  activities    Activity[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]
  sourceLinks   IssueLink[]         @relation("SourceLinks")
  targetLinks   IssueLink[]         @relation("TargetLinks")
  specLinks     IssueSpecLink[]
  githubPrLinks GitHubPrIssueLink[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([assigneeId])
  @@index([reviewerAssigneeId])
  @@index([parentId])
  @@index([status, archivedAt])
  @@map("issues")
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW_QA
  RECHECK
  DONE
  CANCELED
}

enum IssuePriority {
  HIGH
  MEDIUM
  LOW
}

enum IssueType {
  EPIC
  TASK
  BUG
  SUB_TASK
}

// ─── Label ──────────────────────────────────────────────────

model Label {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(50)
  color     String  @default("#6B7280") @db.VarChar(7)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues IssueLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@map("issue_labels")
}

// ─── Activity ───────────────────────────────────────────────

model Activity {
  id        String   @id @default(uuid())
  field     String   @db.VarChar(50)
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")
  // Client that produced this change — see Issue.source for the
  // accepted values.
  source    String   @default("WEB") @db.VarChar(20)

  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@map("activities")
}

// ─── Comment ────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Client that posted this comment — see Issue.source for the
  // accepted values.
  source    String   @default("WEB") @db.VarChar(20)

  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([issueId])
  @@map("comments")
}

// ─── Attachment ─────────────────────────────────────────────

model Attachment {
  id        String   @id @default(uuid())
  fileName  String   @map("file_name") @db.VarChar(500)
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(200)
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  issueId String? @map("issue_id")
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploaderId String @map("uploader_id")
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([commentId])
  @@map("attachments")
}

// ─── Issue Template ─────────────────────────────────────────

model IssueTemplate {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  type        IssueType @default(TASK)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creatorId String @map("creator_id")
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("issue_templates")
}

// ─── Issue Rule (global) ───────────────────────────────────
// Per-issue-type rules consumed by the MCP `create_issue` flow (and
// the web UI later). Global by design — one rule per IssueType across
// all projects, so the team has a single source of truth for what a
// well-formed bug/task/epic looks like regardless of which project
// the LLM is creating in.
//
// Soft-validated at create time so a missing/invalid template never
// blocks creation; instead the API returns warnings the LLM can
// address with a follow-up update_issue call.

model IssueRule {
  id        String    @id @default(uuid())
  issueType IssueType @unique @map("issue_type")

  /// Pattern for `title`. Treated as either a regex (if it starts/ends
  /// with `/`) or a plain glob with `{var}` placeholders for hints in
  /// the LLM-facing tool output. Validation only checks regex matches
  /// against the literal title.
  titlePattern String? @map("title_pattern") @db.VarChar(500)

  /// Markdown skeleton the LLM is told to use as the description's
  /// starting point (e.g. "## Steps to reproduce\n\n## Expected\n").
  descriptionTemplate String? @map("description_template") @db.Text

  /// Fields the LLM should populate at creation time. Stored as JSON
  /// array of camelCase issue keys ("priority", "assigneeId",
  /// "dueDate", "labels", "description").
  requiredFields Json @default("[]") @map("required_fields")

  /// Defaults merged into the create payload when the LLM omits the
  /// field. Stored as `{ field: value }` JSON.
  defaultValues Json @default("{}") @map("default_values")

  /// Label NAMES auto-attached to issues created against this rule.
  /// Names (not IDs) because labels are per-project and rules are
  /// global — the API resolves names to per-project label IDs at
  /// create time, creating the label if it doesn't exist yet.
  enforcedLabelNames String[] @default([]) @map("enforced_label_names")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("issue_rules")
}

// ─── Notification ──────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String   @db.VarChar(20) // ASSIGNED, COMMENTED, MENTIONED
  message   String   @db.VarChar(500)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issueId String? @map("issue_id")
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  projectId String? @map("project_id")

  actorId String? @map("actor_id")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── API Key ────────────────────────────────────────────────

model ApiKey {
  id        String    @id @default(uuid())
  key       String    @unique @db.VarChar(255)
  keyPrefix String    @map("key_prefix") @db.VarChar(8)
  name      String    @db.VarChar(100)
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── OAuth 2.1 (Authorization Server for MCP / external clients) ──

model OAuthClient {
  id                      String   @id @default(uuid())
  clientId                String   @unique @map("client_id")
  clientSecret            String?  @map("client_secret")
  clientName              String   @map("client_name")
  redirectUris            String[] @map("redirect_uris")
  scopes                  String[] @default(["mcp"])
  grantTypes              String[] @default(["authorization_code", "refresh_token"]) @map("grant_types")
  responseTypes           String[] @default(["code"]) @map("response_types")
  tokenEndpointAuthMethod String   @default("client_secret_basic") @map("token_endpoint_auth_method")
  createdAt               DateTime @default(now()) @map("created_at")

  authCodes     OAuthAuthCode[]
  accessTokens  OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]

  @@map("oauth_clients")
}

model OAuthAuthCode {
  code                String   @id
  clientId            String   @map("client_id")
  userId              String   @map("user_id")
  redirectUri         String   @map("redirect_uri")
  scopes              String[]
  codeChallenge       String   @map("code_challenge")
  codeChallengeMethod String   @default("S256") @map("code_challenge_method")
  resource            String?
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("oauth_auth_codes")
}

model OAuthAccessToken {
  token     String   @id
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  scopes    String[]
  resource  String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  token     String   @id
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  scopes    String[]
  resource  String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_refresh_tokens")
}

// ─── Issue Link ────────────────────────────────────────────

enum IssueLinkType {
  BLOCKS
  IS_BLOCKED_BY
  RELATES_TO
  DUPLICATES
  IS_DUPLICATED_BY
}

model IssueLink {
  id        String        @id @default(uuid())
  type      IssueLinkType
  createdAt DateTime      @default(now()) @map("created_at")

  sourceIssueId String @map("source_issue_id")
  sourceIssue   Issue  @relation("SourceLinks", fields: [sourceIssueId], references: [id], onDelete: Cascade)

  targetIssueId String @map("target_issue_id")
  targetIssue   Issue  @relation("TargetLinks", fields: [targetIssueId], references: [id], onDelete: Cascade)

  creatorId String? @map("creator_id")
  creator   User?   @relation("CreatedLinks", fields: [creatorId], references: [id], onDelete: SetNull)

  @@unique([sourceIssueId, targetIssueId, type])
  @@index([sourceIssueId])
  @@index([targetIssueId])
  @@map("issue_links")
}

// ─── Component ─────────────────────────────────────────────

model Component {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  leadId String? @map("lead_id")
  lead   User?   @relation("ComponentLead", fields: [leadId], references: [id], onDelete: SetNull)

  defaultAssigneeId String? @map("default_assignee_id")
  defaultAssignee   User?   @relation("ComponentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  issues IssueComponent[]

  @@unique([projectId, name])
  @@map("components")
}

model IssueComponent {
  issueId     String    @map("issue_id")
  componentId String    @map("component_id")
  issue       Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([issueId, componentId])
  @@map("issue_components")
}

// ─── Specification (기획서) ─────────────────────────────────

enum SpecStatus {
  DRAFT
  REVIEW
  APPROVED
  DEPRECATED
}

model Specification {
  id        String     @id @default(uuid())
  title     String     @db.VarChar(200)
  content   String     @db.Text
  category  String?    @db.VarChar(50)
  status    SpecStatus @default(DRAFT)
  order     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId String @map("creator_id")
  creator   User   @relation("CreatedSpecs", fields: [creatorId], references: [id], onDelete: Cascade)

  sections   SpecSection[]
  comments   SpecComment[]
  issueLinks IssueSpecLink[]

  @@index([projectId, status])
  @@map("specifications")
}

model SpecSection {
  id        String @id @default(uuid())
  sectionId String @map("section_id") @db.VarChar(100)
  level     Int
  title     String @db.VarChar(300)
  order     Int    @default(0)

  specId String        @map("spec_id")
  spec   Specification @relation(fields: [specId], references: [id], onDelete: Cascade)

  comments SpecComment[]

  @@unique([specId, sectionId])
  @@index([specId, order])
  @@map("spec_sections")
}

model SpecComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specId String        @map("spec_id")
  spec   Specification @relation(fields: [specId], references: [id], onDelete: Cascade)

  sectionId String?      @map("section_id")
  section   SpecSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation("SpecComments", fields: [userId], references: [id], onDelete: Cascade)

  parentId String?       @map("parent_id")
  parent   SpecComment?  @relation("SpecCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  SpecComment[] @relation("SpecCommentReplies")

  @@index([specId, resolved])
  @@index([userId])
  @@index([parentId])
  @@map("spec_comments")
}

// ─── Project Credential ───────────────────────────────────

model ProjectCredential {
  id          String  @id @default(uuid())
  name        String
  serviceType String  @map("service_type")
  description String?
  url         String?
  entries     Json // [{ key: "Access Key", value: "AKIA...", sensitive: true }]

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id")
  createdBy   User   @relation("UserCredentials", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_credentials")
}

// ─── Issue-Spec Link ───────────────────────────────────────

model IssueSpecLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  specId String        @map("spec_id")
  spec   Specification @relation(fields: [specId], references: [id], onDelete: Cascade)

  sectionSlug String @default("") @map("section_slug") @db.VarChar(100)

  @@unique([issueId, specId, sectionSlug])
  @@index([issueId])
  @@index([specId])
  @@map("issue_spec_links")
}

// ─── Slack Integration ────────────────────────────────────

model SlackIntegration {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  teamName      String   @map("team_name")
  botToken      String   @map("bot_token")
  installedBy   User     @relation(fields: [installedById], references: [id])
  installedById String   @map("installed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reportConfigs  DailyReportConfig[]
  standupConfigs StandupConfig[]

  @@unique([teamId])
  @@map("slack_integrations")
}

// ─── Daily Report Config ──────────────────────────────────

model DailyReportConfig {
  id       String  @id @default(uuid())
  enabled  Boolean @default(false)
  timezone String  @default("Asia/Seoul")

  morningTime        String  @default("09:00") @map("morning_time")
  morningChannelId   String? @map("morning_channel_id")
  morningChannelName String? @map("morning_channel_name")

  lunchTime        String  @default("13:00") @map("lunch_time")
  lunchChannelId   String? @map("lunch_channel_id")
  lunchChannelName String? @map("lunch_channel_name")

  eveningTime        String  @default("18:00") @map("evening_time")
  eveningChannelId   String? @map("evening_channel_id")
  eveningChannelName String? @map("evening_channel_name")

  skipWeekends Boolean @default(true) @map("skip_weekends")

  morningLastSent DateTime? @map("morning_last_sent")
  lunchLastSent   DateTime? @map("lunch_last_sent")
  eveningLastSent DateTime? @map("evening_last_sent")

  project   Project @relation(fields: [projectId], references: [id])
  projectId String  @unique @map("project_id")

  slackIntegration   SlackIntegration @relation(fields: [slackIntegrationId], references: [id])
  slackIntegrationId String           @map("slack_integration_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daily_report_configs")
}

// ─── Standup Bot ─────────────────────────────────────────

enum StandupReportStatus {
  ACTIVE
  ANSWERED
  AWAY
  CANCELED
  UNANSWERED
}

model StandupQuestion {
  id         String   @id @default(uuid())
  text       String   @db.VarChar(500)
  ignoreText String   @default("nothing nope none no -") @map("ignore_text")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  configs StandupConfigQuestion[]
  answers StandupAnswer[]

  @@map("standup_questions")
}

model StandupConfig {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  greeting    String  @default("Hello *{{username}}*, it's time for your *{{config_name}}*") @db.Text
  goodbye     String  @default("Thank you for your report.") @db.Text
  channelId   String  @map("channel_id")
  channelName String? @map("channel_name")

  cronHour      String @default("9") @map("cron_hour")
  cronMinute    String @default("0") @map("cron_minute")
  cronDayOfWeek String @default("1-5") @map("cron_day_of_week")

  timezone String  @default("Asia/Seoul")
  enabled  Boolean @default(true)

  slackIntegrationId String           @map("slack_integration_id")
  slackIntegration   SlackIntegration @relation(fields: [slackIntegrationId], references: [id], onDelete: Cascade)

  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  questions StandupConfigQuestion[]
  members   StandupConfigMember[]
  reports   StandupReport[]

  @@map("standup_configs")
}

model StandupConfigQuestion {
  configId   String          @map("config_id")
  questionId String          @map("question_id")
  order      Int
  config     StandupConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  question   StandupQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([configId, questionId])
  @@map("standup_config_questions")
}

model StandupConfigMember {
  configId    String        @map("config_id")
  slackUserId String        @map("slack_user_id")
  username    String?
  isAway      Boolean       @default(false) @map("is_away")
  config      StandupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@id([configId, slackUserId])
  @@map("standup_config_members")
}

model StandupReport {
  id                   String              @id @default(uuid())
  status               StandupReportStatus @default(ACTIVE)
  slackUserId          String              @map("slack_user_id")
  username             String?
  currentQuestionOrder Int?                @map("current_question_order")

  configId String        @map("config_id")
  config   StandupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  answers    StandupAnswer[]
  remindedAt DateTime?       @map("reminded_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([configId, createdAt])
  @@index([slackUserId, status])
  @@map("standup_reports")
}

model StandupAnswer {
  id        String  @id @default(uuid())
  answer    String? @db.Text
  messageTs String? @map("message_ts")
  order     Int

  reportId String        @map("report_id")
  report   StandupReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  questionId String          @map("question_id")
  question   StandupQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([reportId, questionId])
  @@map("standup_answers")
}

// ─── GitHub Integration ─────────────────────────────

model GitHubIntegration {
  id            String  @id @default(uuid())
  accessToken   String  @map("access_token")
  webhookSecret String  @map("webhook_secret")
  ownerLogin    String  @map("owner_login")
  repoName      String? @map("repo_name")

  onPrOpenStatus  String? @map("on_pr_open_status")
  onPrMergeStatus String? @map("on_pr_merge_status")
  autoLinkEnabled Boolean @default(true) @map("auto_link_enabled")

  projectId     String  @unique @map("project_id")
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installedById String  @map("installed_by_id")
  installedBy   User    @relation(fields: [installedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pullRequests GitHubPullRequest[]

  @@map("github_integrations")
}

model GitHubPullRequest {
  id           String    @id @default(uuid())
  githubId     Int       @map("github_id")
  number       Int
  title        String    @db.VarChar(500)
  url          String
  state        String    @db.VarChar(20)
  authorLogin  String    @map("author_login")
  authorAvatar String?   @map("author_avatar")
  repoFullName String    @map("repo_full_name")
  baseBranch   String    @map("base_branch")
  headBranch   String    @map("head_branch")
  mergedAt     DateTime? @map("merged_at")

  integrationId String            @map("integration_id")
  integration   GitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  issueLinks GitHubPrIssueLink[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([integrationId, githubId])
  @@map("github_pull_requests")
}

model GitHubPrIssueLink {
  id String @id @default(uuid())

  pullRequestId String            @map("pull_request_id")
  pullRequest   GitHubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pullRequestId, issueId])
  @@index([issueId])
  @@map("github_pr_issue_links")
}

// ─── Outbox ────────────────────────────────────────────────
//
// Transactional outbox for at-least-once delivery of side-effects
// (Slack DMs, future webhooks, etc.). Rows are written INSIDE the
// same $transaction as the business write; OutboxPublisher polls
// undelivered rows on a 5s cron and dispatches via handler registry.

model OutboxEvent {
  id            String @id @default(uuid()) @db.Uuid
  eventType     String @map("event_type")
  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id") @db.Uuid
  payload       Json

  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  nextRetryAt DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz

  sequenceNo BigInt @default(autoincrement()) @map("sequence_no")

  @@index([nextRetryAt], map: "idx_outbox_undelivered")
  @@index([aggregateType, aggregateId, sequenceNo], map: "idx_outbox_aggregate")
  @@index([deliveredAt], map: "idx_outbox_cleanup")
  @@map("outbox_events")
}
